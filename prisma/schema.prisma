generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  PENDING
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(USER)
  status        UserStatus     @default(ACTIVE)
  permissions   String[]       @default([])
  avatarUrl     String?
  lastLoginAt   DateTime?
  lastSeenAt    DateTime?
  lastDevice    String?
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  sidebarItems SidebarItem[] @relation("SidebarCreator")
  notifications Notification[]
  accessLogs AccessLog[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  remember   Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model SidebarItem {
  key       String  @id
  label     String  @db.VarChar(80)
  href      String? @unique
  embedUrl  String?
  parentKey String?
  createdById String?
  createdBy User? @relation("SidebarCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parent SidebarItem? @relation("SidebarChildren", fields: [parentKey], references: [key], onDelete: Cascade)
  children SidebarItem[] @relation("SidebarChildren")
  section   String  @default("main") @db.VarChar(16)
  sortOrder Int     @default(0)

  @@map("sidebar_items")
  @@index([parentKey])
  @@index([createdById])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(160)
  message   String   @db.Text
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model AccessLog {
  id String @id @default(uuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName String @db.VarChar(100)
  userEmail String @db.VarChar(254)
  avatarUrl String?
  status String @default("VALID") @db.VarChar(16)
  device String @db.VarChar(16)
  userAgent String? @db.VarChar(512)
  ip String? @db.VarChar(64)
  locationStatus String @default("not_requested") @db.VarChar(20)
  latitude Float?
  longitude Float?
  accuracy Float?
  city String? @db.VarChar(160)
  region String? @db.VarChar(160)
  country String? @db.VarChar(2)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc), id])
  @@index([userId, createdAt(sort: Desc)])
  @@map("access_logs")
}

model CompanyProfile {
  id String @id @default("main")
  cnpj String @db.VarChar(14)
  legalName String @db.VarChar(160)
  tradeName String @default("") @db.VarChar(160)
  email String @default("") @db.VarChar(254)
  phone String @default("") @db.VarChar(20)
  postalCode String @db.VarChar(8)
  street String @db.VarChar(160)
  number String @db.VarChar(20)
  district String @db.VarChar(100)
  complement String @default("") @db.VarChar(160)
  city String @db.VarChar(100)
  state String @db.VarChar(2)
  municipalRegistration String @default("") @db.VarChar(40)
  stateRegistration String @default("") @db.VarChar(40)
  substituteRegistration String @default("") @db.VarChar(40)
  taxRegime String @db.VarChar(24)
  cnae String @default("") @db.VarChar(7)
  accountantEnabled Boolean @default(false)
  accountantName String @default("") @db.VarChar(100)
  accountantEmail String @default("") @db.VarChar(254)
  accountantPhone String @default("") @db.VarChar(20)
  accountantCrc String @default("") @db.VarChar(40)
  logoDataUrl String? @db.Text
  boletoLogoDataUrl String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_profile")
}
